{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medical3d.local/schema/layer-mapping.schema.json",
  "type": "object",
  "required": ["schemaVersion", "layers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "layers": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["source", "name"], "additionalProperties": false, "properties": { "source": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } } } }
  }
}
